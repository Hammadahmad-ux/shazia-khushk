# Supabase project connection, used only by server-only commerce/admin
# code (Server Actions and Server Components -- never the browser
# bundle). Copy this file to .env.local and fill in real values from
# your Supabase project's Settings > API page. Never commit .env.local.

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Secret key (Supabase dashboard: Settings > API > "Secret keys"; older
# projects call this the "service_role" key -- SUPABASE_SERVICE_ROLE_KEY
# is also accepted). Full-privilege, bypasses Row Level Security.
# Server-only -- never prefix with NEXT_PUBLIC_ or reference it from a
# "use client" component.
SUPABASE_SECRET_KEY=

# Email allowed to sign in to /admin. Verified server-side on every
# admin request, in addition to requiring a valid Supabase Auth
# session -- see src/lib/admin/config.ts.
ADMIN_ALLOWED_EMAIL=teamshaziakhushk@gmail.com

# Public site URL used by server-side SEO metadata (canonical URLs,
# Open Graph, robots.txt and sitemap.xml). A public value -- never a
# secret. Defaults to https://shazia-khushk.vercel.app when unset.
SITE_URL=https://shazia-khushk.vercel.app
